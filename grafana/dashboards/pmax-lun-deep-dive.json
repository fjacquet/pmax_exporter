{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "title": "PowerMax — LUN deep dive",
  "uid": "pmax-lun-deep-dive",
  "tags": ["pmax", "powermax", "dell", "storage", "lun"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"title": "Overview", "type": "link", "icon": "external link", "url": "/d/pmax-overview/powermax-overview?var-server=${server}&var-array=${array}", "targetBlank": false, "keepTime": true, "includeVars": false}
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Unisphere",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(pmax_up, server)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "array",
        "label": "Array",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(pmax_array_perf_timestamp_seconds{server=~\"$server\"}, array)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "storage_group",
        "label": "Storage group",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(pmax_volume_read_iops{server=~\"$server\", array=~\"$array\"}, storage_group)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "volume",
        "label": "Volume (LUN)",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(pmax_volume_read_iops{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\"}, volume)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "text", "title": "",
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "**LUN-level series are opt-in** — set `collection.volumeMetrics: true` (performance) and `collection.volumeInventory: true` (capacity & identity) in the exporter config, ideally scoped with `collection.volumeStorageGroups`. Empty panels mean the opt-ins are off."}
    },
    {
      "id": 2, "type": "stat", "title": "LUNs reporting",
      "description": "Distinct volumes reporting performance data for the current selection.",
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(count by (array, volume) (pmax_volume_read_iops{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}
    },
    {
      "id": 3, "type": "stat", "title": "Total LUN IOPS",
      "description": "Aggregate read + write IOPS across the selected LUNs.",
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(pmax_volume_read_iops{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"}) + sum(pmax_volume_write_iops{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "iops", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}
    },
    {
      "id": 4, "type": "stat", "title": "Worst LUN RT",
      "description": "Highest LUN response time (read or write) across the selection. Yellow > 1 ms, red > 2 ms.",
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "max(pmax_volume_read_response_time_milliseconds{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "instant": true, "refId": "A"},
        {"expr": "max(pmax_volume_write_response_time_milliseconds{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "instant": true, "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "id": 5, "type": "stat", "title": "Highest allocated %",
      "description": "Fullest LUN by allocated percentage across the selection. Yellow > 70%, red > 90%.",
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(pmax_volume_allocated_percent{server=~\"$server\", array=~\"$array\", volume=~\"$volume\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },

    {
      "id": 100, "type": "row", "title": "LUN performance", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4}, "panels": []
    },
    {
      "id": 10, "type": "timeseries", "title": "LUN IOPS (top 20)",
      "description": "Twenty busiest LUNs by read/write IOPS.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "topk(20, pmax_volume_read_iops{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}} read"},
        {"expr": "topk(20, pmax_volume_write_iops{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}} write"}
      ],
      "fieldConfig": {"defaults": {"unit": "iops", "min": 0, "custom": {"fillOpacity": 8}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 11, "type": "timeseries", "title": "LUN bandwidth (top 20)",
      "description": "Twenty busiest LUNs by read/write throughput (MB/s).",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "topk(20, pmax_volume_read_megabytes_per_second{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}} read"},
        {"expr": "topk(20, pmax_volume_write_megabytes_per_second{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}} write"}
      ],
      "fieldConfig": {"defaults": {"unit": "MBs", "min": 0, "custom": {"fillOpacity": 8}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 20, "type": "timeseries", "title": "LUN response time (top 20)",
      "description": "Twenty slowest LUNs by read/write response time (ms). Yellow > 1 ms, red > 2 ms.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "topk(20, pmax_volume_read_response_time_milliseconds{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}} read"},
        {"expr": "topk(20, pmax_volume_write_response_time_milliseconds{server=~\"$server\", array=~\"$array\", storage_group=~\"$storage_group\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}} write"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"fillOpacity": 8, "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 21, "type": "bargauge", "title": "LUN allocated % (top 20)",
      "description": "Twenty most-allocated LUNs. Yellow > 70%, red > 90%.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(20, pmax_volume_allocated_percent{server=~\"$server\", array=~\"$array\", volume=~\"$volume\"})", "legendFormat": "{{array}} {{volume}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "displayMode": "gradient", "orientation": "horizontal"}
    },

    {
      "id": 101, "type": "row", "title": "Inventory", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "panels": []
    },
    {
      "id": 30, "type": "table", "title": "LUN identity & capacity",
      "description": "Per-LUN identity (WWN, identifier, type, storage groups) joined with capacity. Sorted by capacity descending.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "pmax_volume_info{server=~\"$server\", array=~\"$array\", volume=~\"$volume\"}", "format": "table", "instant": true, "refId": "A"},
        {"expr": "pmax_volume_capacity_gigabytes{server=~\"$server\", array=~\"$array\", volume=~\"$volume\"}", "format": "table", "instant": true, "refId": "B"}
      ],
      "transformations": [
        {"id": "joinByField", "options": {"byField": "volume", "mode": "outer"}},
        {"id": "organize", "options": {
          "excludeByName": {"Time 1": true, "Time 2": true, "Value #A": true, "__name__ 1": true, "__name__ 2": true, "server 2": true, "array 2": true, "job 1": true, "job 2": true, "instance 1": true, "instance 2": true},
          "renameByName": {"server 1": "server", "array 1": "array", "Value #B": "capacity (GB)", "identifier": "identifier", "wwn": "WWN", "storage_groups": "storage groups", "type": "type"}
        }}
      ],
      "fieldConfig": {"defaults": {}, "overrides": [{"matcher": {"id": "byName", "options": "capacity (GB)"}, "properties": [{"id": "unit", "value": "decgbytes"}, {"id": "decimals", "value": 1}]}]},
      "options": {"sortBy": [{"displayName": "capacity (GB)", "desc": true}]}
    }
  ]
}
